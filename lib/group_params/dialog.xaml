<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LB Set Parameter in Groups"
    Width="1180" Height="960"
    MinWidth="980" MinHeight="720"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="#F4F4F4"
    FontFamily="Founders Grotesk Regular, Arial"
    FontSize="14">

  <Window.Resources>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Founders Grotesk Medium, Arial"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#111111"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#333333"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MetaLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#666666"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Height" Value="28"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="BorderBrush" Value="#CCCCCC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="130"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="#111111"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#666666"/>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button">
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinWidth" Value="92"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="#444444"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
    </Style>

    <Style x:Key="ListLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#555555"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="PanelBorder" TargetType="Border">
      <Setter Property="BorderBrush" Value="#CCCCCC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
    </Style>

  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- what to change -->
      <RowDefinition Height="Auto"/>   <!-- diagnosis -->
      <RowDefinition Height="*"/>      <!-- mapping table -->
      <RowDefinition Height="Auto"/>   <!-- options -->
      <RowDefinition Height="Auto"/>   <!-- status + actions -->
    </Grid.RowDefinitions>

    <!-- ═══ WHAT TO CHANGE ══════════════════════════════════════════════ -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource SectionHeader}" Text="WHAT TO CHANGE"/>
      <Border Style="{StaticResource PanelBorder}" Padding="10,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                     Text="Category:" Margin="0,0,6,0"/>
          <ComboBox x:Name="CategoryCombo" Grid.Column="1" Height="28"
                    FontSize="13" Margin="0,0,18,0"/>

          <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}"
                     Text="Group by:" Margin="0,0,6,0"/>
          <ComboBox x:Name="GroupByCombo" Grid.Column="3" Height="28"
                    FontSize="13" Margin="0,0,18,0"
                    ToolTip="Elements sharing this value form one row, e.g. Name"/>

          <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}"
                     Text="Set parameter:" Margin="0,0,6,0"/>
          <ComboBox x:Name="TargetCombo" Grid.Column="5" Height="28"
                    FontSize="13" Margin="0,0,18,0"
                    ToolTip="The parameter whose value you want to change"/>

          <Button x:Name="AnalyseBtn" Grid.Column="6"
                  Style="{StaticResource SmallButton}"
                  Content="Analyse" MinWidth="110"
                  HorizontalAlignment="Left"/>
        </Grid>
      </Border>
    </StackPanel>

    <!-- ═══ DIAGNOSIS ═══════════════════════════════════════════════════ -->
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource SectionHeader}"
                 Text="WHY REVIT BLOCKS THIS, AND WHETHER IT CAN BE WORKED AROUND"/>
      <Border Style="{StaticResource PanelBorder}" Padding="10,8">
        <StackPanel>
          <TextBlock x:Name="DiagParamText" Style="{StaticResource FieldLabel}"
                     TextWrapping="Wrap" Text="Press Analyse to inspect the model."/>
          <TextBlock x:Name="DiagVaryText" Style="{StaticResource FieldLabel}"
                     TextWrapping="Wrap" Margin="0,5,0,0" Text=""/>
          <TextBlock x:Name="DiagGroupText" Style="{StaticResource MetaLabel}"
                     TextWrapping="Wrap" Margin="0,5,0,0" Text=""/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ═══ VALUES ══════════════════════════════════════════════════════ -->
    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="VALUES"/>

      <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
        <ScrollViewer x:Name="RowScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="RowContainer" Margin="8,6"/>
        </ScrollViewer>
      </Border>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Style="{StaticResource FieldLabel}"
                   Text="Set all blank rows to:" Margin="0,0,6,0"/>
        <TextBox x:Name="FillAllBox" Style="{StaticResource FieldBox}" Width="90"
                 Margin="0,0,5,0"/>
        <Button x:Name="FillBlanksBtn" Style="{StaticResource SmallButton}"
                Content="Fill blanks" MinWidth="100"/>
        <Button x:Name="ClearAllBtn" Style="{StaticResource SmallButton}"
                Content="Clear all" MinWidth="90"/>
        <Button x:Name="MatchKeysBtn" Style="{StaticResource SmallButton}"
                Content="Match keys by name" MinWidth="140"
                ToolTip="For a key parameter: set every row to the key whose name matches the row's group-by value, e.g. rooms named 1B2P get the 1B2P key."/>
        <Button x:Name="KeySchedBtn" Style="{StaticResource SmallButton}"
                Content="Set up key schedule" MinWidth="150"
                ToolTip="Create a key schedule driving this parameter, one key per row above, and assign the keys. Values then live on the keys — which are not in any group — so future changes need no grouped write at all."/>
        <TextBlock Style="{StaticResource MetaLabel}" Margin="14,0,0,0"
                   Text="A blank row is left untouched. Rows already holding the value you type are skipped."/>
      </StackPanel>
    </Grid>

    <!-- ═══ OPTIONS ═════════════════════════════════════════════════════ -->
    <StackPanel Grid.Row="3" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource SectionHeader}" Text="OPTIONS"/>
      <Border Style="{StaticResource PanelBorder}" Padding="10,8">
        <StackPanel>
          <CheckBox x:Name="EnableVaryCb" IsChecked="True" FontSize="13"
                    Content="Enable &quot;Values can vary by group instance&quot; if needed (this is what lets Revit write inside groups)"/>
          <CheckBox x:Name="RestoreVaryCb" IsChecked="False" FontSize="13"
                    Margin="0,8,0,0"
                    Content="Switch it back off afterwards — WARNING: Revit then aligns values across group instances, which can overwrite per-instance values"/>
          <CheckBox x:Name="AutoResolveCb" IsChecked="False" FontSize="13"
                    Margin="0,8,0,0"
                    Content="Let Revit resolve errors during a rebuild — WARNING: for &quot;Can't keep elements joined&quot; this UNJOINS geometry. Try a dry run with it on first."/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ═══ STATUS + ACTIONS ════════════════════════════════════════════ -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="StatusText" Grid.Column="0"
                 Style="{StaticResource FieldLabel}"
                 TextWrapping="Wrap" VerticalAlignment="Center" Text=""/>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="PreviewBtn" Style="{StaticResource CancelButton}"
                Content="Preview"/>
        <Button x:Name="RebuildTestBtn" Style="{StaticResource CancelButton}"
                Content="Rebuild: dry run" MinWidth="140"
                ToolTip="Ungroup one instance, change the values, regroup and swap the other instances onto the new type — then roll it all back and report exactly what it would have done. Changes nothing."/>
        <Button x:Name="RebuildBtn" Style="{StaticResource ActionButton}"
                Content="Rebuild groups" MinWidth="140"
                ToolTip="The same, committed for real. Only available once a dry run has come back clean."/>
        <Button x:Name="ApplyBtn" Style="{StaticResource ActionButton}"
                Content="Apply"/>
        <Button x:Name="CloseBtn" Style="{StaticResource CancelButton}"
                Content="Close"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
