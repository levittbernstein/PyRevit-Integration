<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LB Keynote Manager"
    Width="1020" Height="900"
    MinWidth="860" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="#F4F4F4"
    FontFamily="Founders Grotesk Regular, Arial"
    FontSize="12">

  <Window.Resources>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Founders Grotesk Medium, Arial"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#111111"/>
      <Setter Property="Padding" Value="10,5"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#333333"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MetaLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="#666666"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="BorderBrush" Value="#CCCCCC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="120"/>
      <Setter Property="Background" Value="#111111"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#666666"/>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button">
      <Setter Property="Height" Value="26"/>
      <Setter Property="MinWidth" Value="84"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Background" Value="#444444"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
    </Style>

    <Style x:Key="ListLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#555555"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <Style x:Key="PanelBorder" TargetType="Border">
      <Setter Property="BorderBrush" Value="#CCCCCC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
    </Style>

  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- keynote file info -->
      <RowDefinition Height="Auto"/>   <!-- categories -->
      <RowDefinition Height="*"/>      <!-- keynote list -->
      <RowDefinition Height="Auto"/>   <!-- numbering options -->
      <RowDefinition Height="Auto"/>   <!-- duplicates -->
      <RowDefinition Height="Auto"/>   <!-- status + buttons -->
    </Grid.RowDefinitions>

    <!-- ═══ KEYNOTE FILE ═══════════════════════════════════════════════ -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource SectionHeader}" Text="KEYNOTE FILE"/>
      <Border Style="{StaticResource PanelBorder}" Padding="10,8">
        <StackPanel>
          <TextBlock x:Name="FilePathText" Style="{StaticResource FieldLabel}"
                     TextWrapping="Wrap" Text="(resolving...)"/>
          <TextBlock x:Name="FileMetaText" Style="{StaticResource MetaLabel}"
                     Margin="0,4,0,0" TextWrapping="Wrap" Text=""/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ═══ CATEGORIES ═════════════════════════════════════════════════ -->
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource SectionHeader}" Text="CATEGORIES"/>
      <Border Style="{StaticResource PanelBorder}" Padding="10,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Style="{StaticResource ListLabel}"
                       Text="Category key becomes the keynote prefix (e.g. R = Railings gives R01, R02)"/>
            <ListBox x:Name="CategoryList" Height="104"
                     BorderBrush="#DDDDDD" BorderThickness="1"/>
          </StackPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Width="200">
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="NewCatKey" Grid.Column="0"
                       Style="{StaticResource FieldBox}" Margin="0,0,4,0"
                       ToolTip="Prefix, e.g. R"/>
              <TextBox x:Name="NewCatName" Grid.Column="1"
                       Style="{StaticResource FieldBox}"
                       ToolTip="Category name, e.g. Railings"/>
            </Grid>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="AddCatBtn" Style="{StaticResource SmallButton}" Content="Add"/>
              <Button x:Name="DelCatBtn" Style="{StaticResource SmallButton}" Content="Delete"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
              <Button x:Name="CatUpBtn" Style="{StaticResource SmallButton}" Content="Move Up"/>
              <Button x:Name="CatDownBtn" Style="{StaticResource SmallButton}" Content="Move Down"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <!-- ═══ KEYNOTES ═══════════════════════════════════════════════════ -->
    <!-- A Grid, NOT a StackPanel: a vertical StackPanel gives its children
         unlimited height, so the ScrollViewer would size to all 44 rows and
         push the action buttons off the bottom of the window. Auto/*/Auto
         constrains the list to the space left over and keeps the buttons
         visible. -->
    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="KEYNOTES"/>

      <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
        <ScrollViewer x:Name="KeynoteScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="KeynoteContainer" Margin="8,6"/>
        </ScrollViewer>
      </Border>

      <StackPanel Grid.Row="2" Margin="0,8,0,0">
        <TextBlock Style="{StaticResource ListLabel}"
                   Text="Drag the ≡ handle to reorder, or drop onto a category header to move a keynote into it. NEW and KEYNOTE TEXT are editable."/>

        <!-- Add a brand-new keynote -->
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                     Text="New keynote:" Margin="0,0,6,0"/>
          <TextBox x:Name="NewKeynoteText" Grid.Column="1"
                   Style="{StaticResource FieldBox}" Margin="0,0,5,0"
                   ToolTip="Keynote description. Press Enter or click Add. Goes into the category selected above, or uncategorised if none is selected."/>
          <Button x:Name="AddKeynoteBtn" Grid.Column="2"
                  Style="{StaticResource SmallButton}"
                  Content="Add keynote" MinWidth="100" Margin="0"/>
        </Grid>

        <StackPanel Orientation="Horizontal">
          <Button x:Name="EntryUpBtn" Style="{StaticResource SmallButton}" Content="Move Up"/>
          <Button x:Name="EntryDownBtn" Style="{StaticResource SmallButton}" Content="Move Down"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Assign to:" Margin="12,0,6,0"/>
          <ComboBox x:Name="AssignCombo" Width="140" Height="26" Margin="0,0,5,0"/>
          <Button x:Name="AssignBtn" Style="{StaticResource SmallButton}" Content="Assign"/>
          <Button x:Name="UnassignBtn" Style="{StaticResource SmallButton}"
                  Content="Remove from category" MinWidth="138"/>
          <Button x:Name="SortBtn" Style="{StaticResource SmallButton}" Content="Sort by text"/>
          <Button x:Name="ResetKeysBtn" Style="{StaticResource SmallButton}"
                  Content="Reset manual keys" MinWidth="118"/>
          <Button x:Name="SelectAllBtn" Style="{StaticResource SmallButton}" Content="Select all"/>
          <Button x:Name="SelectNoneBtn" Style="{StaticResource SmallButton}" Content="Clear"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ═══ NUMBERING ══════════════════════════════════════════════════ -->
    <StackPanel Grid.Row="3" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource SectionHeader}" Text="NUMBERING"/>
      <Border Style="{StaticResource PanelBorder}" Padding="10,8">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="UsePrefixCb" Content="Use category prefix"
                      IsChecked="True" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Digits:" Margin="20,0,6,0"/>
            <TextBox x:Name="PaddingBox" Style="{StaticResource FieldBox}"
                     Width="40" Text="2"/>
            <TextBlock x:Name="ModeHintText" Style="{StaticResource MetaLabel}"
                       Margin="16,0,0,0" Text=""/>
          </StackPanel>
          <CheckBox x:Name="RenumUncatCb" Margin="0,8,0,0"
                    Content="Also renumber keynotes that are not in a category (closes gaps, but rewrites many more tags)"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ═══ DUPLICATES ═════════════════════════════════════════════════ -->
    <StackPanel x:Name="DuplicatePanel" Grid.Row="4" Margin="0,0,0,12"
                Visibility="Collapsed">
      <TextBlock Style="{StaticResource SectionHeader}" Text="DUPLICATE KEYNOTE TEXT"/>
      <Border Style="{StaticResource PanelBorder}" Padding="10,8">
        <StackPanel>
          <TextBlock x:Name="DuplicateInfo" Style="{StaticResource MetaLabel}"
                     TextWrapping="Wrap" Margin="0,0,0,6" Text=""/>
          <ListBox x:Name="DuplicateList" Height="72"
                   BorderBrush="#DDDDDD" BorderThickness="1"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="MergeBtn" Style="{StaticResource SmallButton}"
                    Content="Merge selected" MinWidth="120"/>
            <TextBlock Style="{StaticResource MetaLabel}" VerticalAlignment="Center"
                       Text="Keeps the lowest key and repoints all references onto it."/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ═══ STATUS + ACTIONS ═══════════════════════════════════════════ -->
    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="StatusText" Grid.Column="0"
                 Style="{StaticResource FieldLabel}"
                 TextWrapping="Wrap" VerticalAlignment="Center" Text=""/>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="PreviewBtn" Style="{StaticResource CancelButton}"
                Content="Preview changes"/>
        <Button x:Name="UpdateBtn" Style="{StaticResource ActionButton}"
                Content="Update model"/>
        <Button x:Name="CloseBtn" Style="{StaticResource CancelButton}"
                Content="Close"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
